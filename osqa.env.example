# OSQA on a company server — settings. `npm run server:setup -- https://your-address` copies this to
# osqa.env and fills in the notification keys. Keep osqa.env private (it holds a secret); it is
# not in the repository.

# Where the server listens. 127.0.0.1 = only the reverse proxy (IIS, nginx) on this machine reaches it.
HOST=127.0.0.1
PORT=8080

# The proxy passes the client's address and https in X-Forwarded-For / X-Forwarded-Proto.
# Set to 1 only when a reverse proxy is in front (otherwise anyone could claim any address).
TRUST_PROXY=1

# Or serve HTTPS directly (company certificate). Browsers need HTTPS for the sign-in cookie.
# TLS_CERT=certs/osqa.crt
# TLS_KEY=certs/osqa.key

# The database (osqa.sqlite) and the automatic backups (backups/) live here — back this folder up.
DATA_DIR=data

# Largest upload (a report with its photos), in MB.
MAX_BODY_MB=20

# Phone notifications (Web Push). The server needs outbound HTTPS to Apple, Google, Mozilla and
# Microsoft push services; without it, notifications still appear inside OSQA.
VAPID_SUBJECT=https://osqa.example.internal
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
